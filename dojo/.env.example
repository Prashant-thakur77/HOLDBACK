# Read by the scripts in this package only (scripts/serve.ts and
# scripts/collect-reports.ts). The engine and the HTTP handler take everything
# through function arguments, so the web app passes its own configuration.

# Firecrawl API key for the public scam report collector (npm run collect).
# Get one at https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Local server (npm run dev). All three are optional.
# URL of a running HOLDBACK agent; check_address asks it for a verdict.
AGENT_URL=
# Secret shared with the agent for POST /v1/dojo/memo; also keys the run seeds.
# Any random string of 16 or more characters, e.g. from: openssl rand -hex 32
DOJO_SECRET=
PORT=8787
