# Everything here is public: it is compiled into the app. Never put a secret key in this file.

# Base URL of the HOLDBACK risk agent (services/agent), no trailing slash. The value below reaches
# `wrangler dev` on the host from an Android emulator; use your deployed https URL for a real build.
EXPO_PUBLIC_AGENT_URL=http://10.0.2.2:8787

# Solana RPC endpoint and the chain the wallet is asked to authorize.
# Use an RPC key that is restricted to this app's package if your provider supports it.
EXPO_PUBLIC_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_SOLANA_CHAIN=solana:devnet

# Token used for payments. Defaults to Circle's devnet USDC when empty.
EXPO_PUBLIC_USDC_MINT=

# Supabase project (Dashboard > Project Settings > API). The anon key is public by design;
# row-level security limits a wallet to its own holds. Leave empty to poll the agent instead.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Pollar publishable key (dashboard.pollar.xyz > API Keys, `pub_testnet_...` for devnet).
# Enable "native clients", the SOLANA chain and USDC on the key. Leave empty to hide Pollar login.
EXPO_PUBLIC_POLLAR_KEY=

# Build-time only (read by app.config.ts, not shipped as code):
# Path to the Firebase `google-services.json` for push (Firebase console > Project settings > Android app
# with package xyz.holdback.app). Without it the app builds and runs, and push stays off.
GOOGLE_SERVICES_JSON=
# Expo project id (expo.dev > project > ID). Needed for push (the agent sends through the Expo push
# service; upload the FCM credentials to the same project with `eas credentials`) and for EAS builds.
EAS_PROJECT_ID=
