{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holdback-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  // nodejs_compat: Next.js and @solana/web3.js need Node built-ins.
  // global_fetch_strictly_public: lets this Worker call the agent Worker over
  // its public URL even when both live on the same account or zone.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "holdback-web",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Custom domain: uncomment and set the hostname once the zone is on this
  // Cloudflare account, then redeploy.
  // "routes": [{ "pattern": "holdback.example.com", "custom_domain": true }]
}
