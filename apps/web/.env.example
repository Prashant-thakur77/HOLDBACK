# HOLDBACK web app. Copy to .env.local for `next dev` and `next build`.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle at build time, so
# they must be present when `next build` (or `npm run deploy`) runs. They are
# not secrets. Everything else is server-only: on Cloudflare set those with
# `wrangler secret put NAME`, and locally put them in .env.local (next dev)
# and .dev.vars (wrangler preview).
#
# Every value is optional. A missing one turns that integration off and the
# app reports it as unavailable; GET /api/health shows what is configured.

# --- Public (build time) -----------------------------------------------------

# Canonical origin of the deployed site, no trailing slash. Used for metadata,
# robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the risk agent Worker (services/agent). Printed by its
# `wrangler deploy`, e.g. https://holdback-agent.<account>.workers.dev
NEXT_PUBLIC_AGENT_URL=

# devnet (default) | testnet | mainnet-beta | localnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# RPC endpoint the browser uses. Leave empty for the cluster's public endpoint.
# This URL is visible to every visitor: use a key restricted to your domain
# (Helius dashboard -> RPCs -> Access control), or leave it empty.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Supabase project URL and anon (public) key:
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (secrets) ---------------------------------------------------

# RPC endpoint for server-side reads and the Solana Action. A keyed URL is fine
# here, e.g. https://devnet.helius-rpc.com/?api-key=... (https://dashboard.helius.dev).
# Falls back to NEXT_PUBLIC_SOLANA_RPC_URL, then to the public endpoint.
#
# Needed on Cloudflare: the public Solana endpoints answer 403 to requests
# from Workers, so without this the Action cannot build transactions and
# receipts cannot read the chain. The fallback is for local development.
SOLANA_RPC_URL=

# Agent URL for server-to-server calls, if it differs from the public one.
AGENT_URL=

# Supabase service role key (Project Settings -> API -> service_role). Used
# only to store Scam Dojo runs. Without it runs are kept in memory and are
# lost when the Worker restarts.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the Scam Dojo. Must equal DOJO_SECRET on the agent, which
# uses it to authorise the end-of-run memo. Generate with: openssl rand -hex 32
DOJO_SECRET=
