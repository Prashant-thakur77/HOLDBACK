{
  "name": "holdback",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Every Solana payment gets an undo window enforced on-chain, sized by a risk agent from cited scam evidence.",
  "workspaces": [
    "sdk",
    "dojo",
    "mcp",
    "services/agent"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "program:build": "anchor build && npm run idl:sync",
    "program:test": "cargo test -p holdback",
    "program:fuzz": "./scripts/fuzz.sh",
    "program:mutants": "python3 scripts/mutation-check.py",
    "program:test:localnet": "anchor build && ./scripts/test-localnet.sh",
    "idl:sync": "node scripts/sync-idl.mjs",
    "readme:numbers": "tsx scripts/readme_numbers.ts",
    "lint": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "lint:fix": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "proofs:verify": "tsx scripts/verify-proofs.ts",
    "proofs:run": "tsx scripts/prove-devnet.ts"
  },
  "devDependencies": {
    "@anchor-lang/core": "^1.2.2",
    "@noble/curves": "^1.9.7",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "prettier": "^3.4.2",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
