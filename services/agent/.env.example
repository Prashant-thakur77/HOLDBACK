# HOLDBACK Guardian: every variable the service reads.
#
# This is the same list as `.dev.vars.example`. `wrangler dev` and the
# scripts in `scripts/` read `.dev.vars`; copy either example to that name.
# Every value is optional locally: a missing key turns the feature that
# needs it to "unavailable". In production, non-secret values go in
# `wrangler.toml` [vars] and everything marked (secret) goes in with
# `wrangler secret put NAME`.

# --- Solana ---------------------------------------------------------------
# RPC of the cluster the HOLDBACK program runs on. REQUIRED when deployed:
# Solana's public endpoints refuse requests that come from the Workers
# runtime (deployed, and the local one under `wrangler dev`), so use a
# private devnet RPC, for example a Helius devnet URL from
# https://dashboard.helius.dev. The public endpoint below only works for the
# scripts and tests, which run under Node.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Mainnet RPC for wallet history, names and Seeker checks. Defaults to the
# Helius mainnet RPC when HELIUS_API_KEY is set. REQUIRED when deployed for
# the same reason as above, unless HELIUS_API_KEY is set.
MAINNET_RPC_URL=
# Only to point at a different deployment; defaults to the id in the SDK's IDL.
PROGRAM_ID=

# --- Signing keys (secret) --------------------------------------------------
# Base58 secret key, or the JSON byte array `solana-keygen new` writes.
# Create each with: solana-keygen new --no-bip39-passphrase -o <name>.json
# ORACLE must be the program config's risk_oracle; RELAYER its relayer.
ORACLE_KEYPAIR=
RELAYER_KEYPAIR=
# Pays fees for release, close, the Dojo memo and the optional flag mirror.
CRANK_KEYPAIR=

# --- Supabase ---------------------------------------------------------------
# Leave both SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY empty to run without
# a database: evidence documents, cached answers and the blocklists are then
# kept in the memory of the running process only (downloaded from the public
# list URLs on first use) and are LOST ON RESTART. The sender-history
# collector stays unavailable in that mode. Never deploy that way.
# Project Settings -> API in https://supabase.com/dashboard
SUPABASE_URL=
# (secret) "service_role" key from the same page.
SUPABASE_SERVICE_ROLE_KEY=
# (secret) Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=

# --- Shared secrets (secret) ------------------------------------------------
# Any long random string, e.g. `openssl rand -hex 32`.
# Signs relay sessions and sign-in challenges.
SESSION_JWT_SECRET=
# Header `x-crank-secret` on POST /v1/crank.
CRANK_SECRET=
# `Authorization: Bearer ...` on POST /v1/dojo/memo.
DOJO_SECRET=

# --- Evidence sources (secret) ----------------------------------------------
# https://dashboard.helius.dev -> API Keys (mainnet history).
HELIUS_API_KEY=
# https://www.chainabuse.com -> profile -> API. One key; never pooled.
CHAINABUSE_API_KEY=
# Calls allowed per calendar month on that key (free tier: 10).
CHAINABUSE_MONTHLY_BUDGET=10
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# Solana Name Service HTTP API. No key needed.
SNS_API_URL=https://sdk-proxy-v2.sns.id

# --- Language model (secret keys) -------------------------------------------
# `anthropic` or `openai`. Used for wording and extraction only.
LLM_PROVIDER=anthropic
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- Voice: ElevenLabs --------------------------------------------------------
# (secret) https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# A voice id from https://elevenlabs.io/app/voice-library (multilingual voice).
ELEVENLABS_VOICE_ID=
# Printed by `npm run voice:setup`.
ELEVENLABS_AGENT_ID=
# Speech model for voice notes.
ELEVENLABS_TTS_MODEL=eleven_v4
# Outbound calls: the id of a Twilio number imported under
# https://elevenlabs.io/app/agents -> Phone Numbers. Leave empty to disable.
ELEVENLABS_PHONE_NUMBER_ID=
# Smallest FLAGGED payment, in USD, that triggers a call.
OUTBOUND_CALL_MIN_USD=100
# `true` makes POST /v1/voice/session require the sender's session token.
VOICE_REQUIRE_AUTH=false

# --- Reports ------------------------------------------------------------------
# (secret) Cloudflare dashboard -> Turnstile -> your widget -> Secret key.
TURNSTILE_SECRET_KEY=
# `true` lets the crank key add one on-chain flag per address once enough
# reports exist.
FLAG_MIRROR_ONCHAIN=false
FLAG_MIRROR_MIN_REPORTS=3

# --- Push ---------------------------------------------------------------------
# (secret, optional) https://expo.dev -> Account settings -> Access tokens.
# Only needed when "Enhanced Security for Push Notifications" is on.
EXPO_ACCESS_TOKEN=

# --- Misc ---------------------------------------------------------------------
# Public origin of the deployed Worker, used in voice-note links.
PUBLIC_BASE_URL=
