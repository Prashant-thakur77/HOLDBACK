# Secrets of the `helius-webhook` Edge function.
# Local: copy to supabase/functions/.env (gitignored).
# Hosted: supabase secrets set --env-file supabase/functions/.env

# Shared secret Helius sends in the Authorization header. Generate one with
# `openssl rand -hex 32` and use the same value as the webhook's authHeader.
HELIUS_WEBHOOK_SECRET=

# Optional. Only needed for enhanced webhooks, whose payloads carry no logs:
# the function then fetches them with getTransaction. Use the RPC URL of the
# same cluster, e.g. https://devnet.helius-rpc.com/?api-key=<key> (key from
# dashboard.helius.dev). Raw webhooks do not need it.
HELIUS_RPC_URL=

# Optional. Defaults to the program id in _shared/holdback.idl.json.
HOLDBACK_PROGRAM_ID=

# Optional. Extra USD stablecoins counted at par in the USD metrics, as
# comma-separated <mint>:<decimals>. Devnet and mainnet USDC are built in.
USD_STABLECOIN_MINTS=

# Optional. Only for projects where the legacy SUPABASE_SERVICE_ROLE_KEY is
# not injected: a secret API key (sb_secret_...) from Project Settings > API keys.
SERVICE_ROLE_KEY=
