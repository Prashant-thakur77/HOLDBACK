{
  "name": "@holdback/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server that lets AI agents pay through HOLDBACK: every payment gets an on-chain undo window sized from scam evidence",
  "license": "MIT",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "holdback-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "solana",
    "holdback",
    "mcp",
    "model-context-protocol",
    "payments",
    "agents"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@holdback/sdk": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
