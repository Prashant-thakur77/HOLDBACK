# Configuration for holdback-mcp. The server reads these from its process
# environment; an MCP client normally passes them in the "env" block of its
# server entry (see README.md). Copy to .env only for local runs.

# Solana RPC endpoint. Defaults to the public devnet endpoint when unset.
# A private endpoint (for example from https://dashboard.helius.dev) is faster
# and is needed for list_holds on providers that restrict account scans.
HOLDBACK_RPC_URL=https://api.devnet.solana.com

# Base URL of the Guardian risk service (services/agent in this repository),
# for example http://localhost:8787 in development or your deployed Worker
# URL. Without it, assess_recipient, send_protected_payment and
# verify_evidence refuse to run: a payment is never built without an
# assessment.
HOLDBACK_GUARDIAN_URL=

# Optional. The wallet the server signs with: a path to a Solana CLI keypair
# file (create one with `solana-keygen new -o agent.json`) or a base58 secret
# key. Leave empty to keep keys out of this process: write tools then return
# unsigned transactions for your own wallet to sign. Never logged.
HOLDBACK_KEYPAIR=

# Optional. Largest single payment the server will build, in whole display
# units of whatever asset is being paid: 50 means 50 USDC or 50 SOL. Set it
# for the asset your agent pays in. Empty means no cap.
HOLDBACK_MAX_AMOUNT=
